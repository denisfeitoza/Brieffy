# ============================================================================
# Brieffy — environment variable contract
# ----------------------------------------------------------------------------
# Copy to `.env.local` (gitignored) for local dev and fill in real values.
# In production these live in the Vercel project env (Settings → Environment
# Variables), NOT in this file. Placeholders below are NOT secrets.
#
# `src/lib/env.ts` validates these at runtime: the REQUIRED block throws on a
# cold start if any is missing/empty (which also blocks every getSupabaseAdmin
# caller, e.g. the admin dashboard). The WARN block degrades gracefully.
# ============================================================================

# --- REQUIRED (assertServerEnv throws if missing or empty) ------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Public app URL. Used as the OpenRouter HTTP-Referer header and required by the
# env audit. No trailing slash. Production value: https://www.brieffy.ai
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- LLM provider (at least one of GROQ_API_KEY / OPENROUTER_API_KEY) --------
GROQ_API_KEY=your-groq-key
OPENROUTER_API_KEY=your-openrouter-key
AI_LLM_PROVIDER=groq
AI_LLM_MODEL=openai/gpt-oss-120b
AI_VOICE_PROVIDER=groq
AI_VOICE_MODEL=whisper-large-v3

# --- Stripe (only required when billing is enabled) -------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
